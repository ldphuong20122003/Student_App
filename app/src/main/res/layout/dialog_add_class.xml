<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="350dp"
    android:layout_height="wrap_content"
    android:padding="10dp"
    android:layout_margin="20dp"
    android:layout_gravity="center"
    android:background="@drawable/border_black"
   >

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Thêm lớp học"
        android:textColor="@color/blue"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/textView"
        android:layout_marginTop="10dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="18dp"
            android:layout_marginBottom="5dp"
            android:text="Mã lớp:"
            />
        <EditText
            android:id="@+id/edt_maLop_add"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:paddingStart="10dp"
          />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="18dp"
            android:layout_marginBottom="5dp"
            android:text="Tên lớp:"
            />
        <EditText
            android:id="@+id/edt_tenLop_add"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:paddingStart="10dp"
           />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Khoa:"
            android:textStyle="bold"
            android:textSize="18dp"
            android:layout_marginBottom="5dp"
            />
        <EditText
            android:id="@+id/edt_khoa_add"
            android:layout_width="match_parent"
            android:paddingStart="10dp"
            android:layout_height="50dp"
           />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="18dp"
            android:layout_marginBottom="5dp"
            android:text="Giảng viên:"
            />
        <EditText
            android:id="@+id/edt_giangVien_add"
            android:layout_width="match_parent"

            android:layout_marginBottom="5dp"
            android:paddingStart="10dp"
            android:layout_height="50dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="18dp"
            android:layout_marginBottom="5dp"
            android:text="Nam hoc:"
            />
        <EditText
            android:id="@+id/edt_namHoc_add"
            android:layout_width="match_parent"

            android:layout_marginBottom="5dp"
            android:paddingStart="10dp"
            android:layout_height="50dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center">
            <Button
                android:id="@+id/btn_add_lop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:layout_marginEnd="50dp"
                android:backgroundTint="@color/blue"
                android:text="Lưu"/>
            <Button
                android:id="@+id/btn_huy_lop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:backgroundTint="@color/red"
                android:text="Hủy"/>
        </LinearLayout>
    </LinearLayout>




</androidx.constraintlayout.widget.ConstraintLayout>