<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="380dp"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="10dp"
    android:layout_margin="20dp"
    android:layout_gravity="center"
    android:background="@drawable/border_black">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_title_class"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Thêm lớp học"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="@color/blue"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mã lớp:"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginVertical="10dp" />

            <EditText
                android:id="@+id/edt_maLop_add"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:paddingStart="10dp"
                android:background="@drawable/edittext_border" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tên lớp:"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginVertical="10dp" />

            <EditText
                android:id="@+id/edt_tenLop_add"
                android:layout_width="match_parent"
                android:layout_height="50dp"

                android:background="@drawable/edittext_border" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chuyên ngành:"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginVertical="10dp" />

            <Spinner
                android:id="@+id/edt_khoa_add"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/spinner_border" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Giảng viên:"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginVertical="10dp" />

            <Spinner
                android:id="@+id/edt_giangVien_add"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/spinner_border" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Năm học:"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginVertical="10dp" />

            <EditText
                android:id="@+id/edt_namHoc_add"
                android:layout_width="match_parent"
                android:layout_height="50dp"

                android:background="@drawable/edittext_border" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Danh sách sinh viên:"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginVertical="10dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hiển thị danh sách"
                    android:textColor="@color/blue"
                    android:textSize="16sp"
                    android:layout_marginVertical="10dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center">

                <Button
                    android:id="@+id/btn_add_lop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:layout_marginEnd="50dp"
                    android:backgroundTint="@color/blue"
                    android:text="Lưu" />

                <Button
                    android:id="@+id/btn_huy_lop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/red"
                    android:text="Hủy" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>