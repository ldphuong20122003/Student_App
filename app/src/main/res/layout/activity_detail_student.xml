<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/txt_title_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chi tiết sinh viên"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/edt_maSV_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Mã sinh viên"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/edt_tenSV_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Tên sinh viên"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/edt_ngaySinh_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ngày sinh"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/edt_queQuan_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Quê quán"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/edt_sdt_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Số điện thoại"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/edt_email_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Email"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/edt_lopHoc_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Lớp học"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/edt_ngayNhaphoc_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ngày nhập học"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/edt_heDaotao_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Hệ đào tạo"
        android:layout_marginBottom="8dp"/>

    <Spinner
        android:id="@+id/spn_chuyenNganh_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btn_edit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sửa"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btn_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Xóa"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quay lại"/>
    </LinearLayout>
</LinearLayout>