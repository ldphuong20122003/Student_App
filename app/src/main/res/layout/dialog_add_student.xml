<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="380dp"
    android:layout_height="match_parent"
    android:padding="10dp"
    android:layout_margin="10dp"
    android:background="@drawable/border_black">

    <TextView
        android:id="@+id/txt_title_subject"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Thêm sinh viên"
        android:textColor="@color/blue"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <LinearLayout
        android:id="@+id/form_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/txt_title_subject"
        app:layout_constraintBottom_toTopOf="@id/btn_add_sv"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginVertical="5dp">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="16dp"
                android:text="Mã sinh viên:" />
            <EditText
                android:id="@+id/edt_maSV_add"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="40dp"
                android:paddingStart="10dp"
                android:maxLines="3"
                android:ellipsize="none"
                android:singleLine="false"
                android:inputType="textMultiLine" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginVertical="5dp">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="16dp"
                android:text="Tên sinh viên:" />
            <EditText
                android:id="@+id/edt_tenSV_add"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="40dp"
                android:paddingStart="10dp"
                android:maxLines="3"
                android:ellipsize="none"
                android:singleLine="false"
                android:inputType="textMultiLine" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginVertical="5dp">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="16dp"
                android:text="Ngày sinh:" />
            <EditText
                android:id="@+id/edt_ngaySinh_add"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="40dp"
                android:paddingStart="10dp"
                android:maxLines="3"
                android:ellipsize="none"
                android:singleLine="false"
                android:inputType="textMultiLine" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginVertical="5dp">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="16dp"
                android:text="Quê quán:" />
            <EditText
                android:id="@+id/edt_queQuan_add"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="40dp"
                android:paddingStart="10dp"
                android:maxLines="3"
                android:ellipsize="none"
                android:singleLine="false"
                android:inputType="textMultiLine" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginVertical="5dp">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="16dp"
                android:text="Số điện thoại:" />
            <EditText
                android:id="@+id/edt_sdt_add"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="40dp"
                android:paddingStart="10dp"
                android:maxLines="3"
                android:ellipsize="none"
                android:singleLine="false"
                android:inputType="textMultiLine" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginVertical="5dp">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="16dp"
                android:text="Email:" />
            <EditText
                android:id="@+id/edt_email_add"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="40dp"
                android:paddingStart="10dp"
                android:maxLines="3"
                android:ellipsize="none"
                android:singleLine="false"
                android:inputType="textMultiLine" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginVertical="5dp">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="16dp"
                android:text="Lớp học:" />
            <EditText
                android:id="@+id/edt_lopHoc_add"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="40dp"
                android:paddingStart="10dp"
                android:maxLines="3"
                android:ellipsize="none"
                android:singleLine="false"
                android:inputType="textMultiLine" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginVertical="5dp">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="16dp"
                android:text="Ngày nhập học:" />
            <EditText
                android:id="@+id/edt_ngayNhaphoc_add"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="40dp"
                android:paddingStart="10dp"
                android:maxLines="3"
                android:ellipsize="none"
                android:singleLine="false"
                android:inputType="textMultiLine" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginVertical="5dp">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="16dp"
                android:text="Hệ đào tạo:" />
            <EditText
                android:id="@+id/edt_heDaotao_add"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="40dp"
                android:paddingStart="10dp"
                android:maxLines="3"
                android:ellipsize="none"
                android:singleLine="false"
                android:inputType="textMultiLine" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginVertical="5dp">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="16dp"
                android:text="Chuyên ngành:" />
            <Spinner
                android:id="@+id/spn_chuyenNganh"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="40dp"
                android:paddingStart="10dp" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btn_add_sv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:backgroundTint="@color/blue"
        android:text="Lưu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_huy_sv"
        app:layout_constraintHorizontal_chainStyle="packed"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_huy_sv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:backgroundTint="@color/red"
        android:text="Hủy"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/btn_add_sv"
        android:layout_marginBottom="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>