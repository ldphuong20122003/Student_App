<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.BROADCAST_STICKY" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Student_App"
        tools:targetApi="31">
        <activity
            android:name=".Activity.Screens.MarkActivity"
            android:exported="false" />
        <activity
            android:name=".Activity.Detail.DetailSubjectActivity"
            android:exported="false" />
        <activity
            android:name=".Activity.Detail.DetailStudentActivity"
            android:exported="false"
            android:launchMode="standard" />
        <activity
            android:name=".Activity.Detail.DetailClassActivity"
            android:exported="false" />
        <activity
            android:name=".Activity.Screens.StudentClassesActivity"
            android:exported="false" />
        <activity
            android:name=".Activity.Screens.StudentListActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:parentActivityName=".Activity.Detail.DetailClassActivity"
            android:screenOrientation="user">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".Activity.Detail.DetailClassActivity" />
        </activity>
        <activity
            android:name=".Activity.Detail.DetailTeacherActivity"
            android:exported="false"
            android:launchMode="standard" />
        <activity
            android:name=".Activity.Screens.SubjectActivity"
            android:exported="false" />
        <activity
            android:name=".Activity.Screens.BranchActivity"
            android:exported="false" />
        <activity
            android:name=".Activity.Screens.ClassActivity"
            android:exported="false" />
        <activity
            android:name=".Activity.Screens.StudentActivity"
            android:exported="false" />
        <activity
            android:name=".Activity.Screens.TeacherActivity"
            android:exported="false" />
        <activity
            android:name=".Activity.LoginActivity"
            android:exported="false" />
        <activity
            android:name=".Activity.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>